<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Modern Android 12+ Splash Screen Theme and backward-compatible core-splashscreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Brand slate dark canvas background (#0F172A) -->
        <item name="windowSplashScreenBackground">#0F172A</item>
        <!-- Vector Scales of Justice icon centered in the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Post splash transition theme -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
